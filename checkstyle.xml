<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- LAVS Checkstyle rules: targets from the proposal's metrics section
     and the course Java coding standards -->
<module name="Checker">
    <property name="severity" value="error"/>

    <module name="TreeWalker">

        <!-- Maintainability: cyclomatic complexity of 10 or less per method -->
        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>

        <!-- Maintainability: conditional nesting depth of 3 or less
             (max counts nested levels inside the first, so 2 = 3 deep) -->
        <module name="NestedIfDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedTryDepth">
            <property name="max" value="1"/>
        </module>

        <!-- Modularity: class fan-out, ignoring JavaFX UI classes so a
             controller isn't penalised for using buttons and fields -->
        <module name="ClassFanOutComplexity">
            <property name="max" value="20"/>
            <property name="excludeClassesRegexps" value="^javafx\..*"/>
        </module>

        <!-- Coding standards: Pascal case for classes -->
        <module name="TypeName"/>

        <!-- Coding standards: camel case for methods and variables -->
        <module name="MethodName"/>

        <!-- Maintainability: no single-letter names except loop counters -->
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
        </module>

        <!-- Constants in UPPER_SNAKE_CASE -->
        <module name="ConstantName"/>

        <!-- Basic hygiene -->
        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>

    </module>
</module>