<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.common.DocumentsTabController"
      spacing="12">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing a document -->
        <fx:include fx:id="documentForm" source="document-form.fxml"/>
    </fx:define>

    <Label text="Documents" styleClass="section-heading"/>
    <VBox fx:id="documentList" spacing="12"/>
    <fx:include fx:id="pager" source="pager.fxml"/>
    <Button text="+  Add document" styleClass="button-add" maxWidth="Infinity"
            onAction="#handleAddDocument"/>
    <HBox styleClass="note">
        <Label text="ⓘ" minWidth="-Infinity"/>
        <Label text="LAVS records each file's name, type and size. The file itself stays with the customer's paperwork."/>
    </HBox>
</VBox>
