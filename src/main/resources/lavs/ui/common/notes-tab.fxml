<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written by Jack, refined with Claude. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.common.NotesTabController"
      spacing="12">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing a note -->
        <fx:include fx:id="noteForm" source="note-form.fxml"/>
    </fx:define>

    <Label text="Notes" styleClass="section-heading"/>
    <VBox fx:id="noteList" spacing="12"/>
    <fx:include fx:id="pager" source="pager.fxml"/>
    <Button text="+  Add note" styleClass="button-add" maxWidth="Infinity"
            onAction="#handleAddNote"/>
    <HBox styleClass="note">
        <Label text="ⓘ" minWidth="-Infinity"/>
        <Label text="Notes are shared with all staff, oldest first. Keep them factual and record who you spoke to."/>
    </HBox>
</VBox>
