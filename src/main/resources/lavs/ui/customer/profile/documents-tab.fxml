<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.customer.profile.DocumentsTabController"
      spacing="12">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing -->
        <fx:include fx:id="documentForm" source="/lavs/ui/common/document-form.fxml"/>
    </fx:define>
    <Label text="Documents" styleClass="section-heading"/>
    <VBox fx:id="documentList" spacing="12"/>
    <fx:include fx:id="pager" source="/lavs/ui/common/pager.fxml"/>
    <Button text="+  Add document" styleClass="button-add" onAction="#handleAddDocument"/>
    <HBox styleClass="note">
        <Label text="ⓘ" minWidth="-Infinity"/>
        <Label text="Choose a file and LAVS records its name, type and size. Only these details are saved; the file itself stays with the customer's paperwork."/>
    </HBox>
</VBox>
