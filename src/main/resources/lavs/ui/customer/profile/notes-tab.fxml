<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.customer.profile.NotesTabController"
      spacing="12">
    <!-- Out past the tab padding and over the card border, so the table runs edge to edge like search -->
    <TableView fx:id="notesTable">
        <VBox.margin>
            <Insets top="-18" left="-17" right="-17"/>
        </VBox.margin>
        <columns>
            <TableColumn fx:id="typeColumn" text="Type"/>
            <TableColumn fx:id="authorColumn" text="Author"/>
            <TableColumn fx:id="dateAddedColumn" text="Date added"/>
            <TableColumn fx:id="arrowColumn" sortable="false" resizable="false"
                         reorderable="false" minWidth="48" maxWidth="48" prefWidth="48"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
    </TableView>
    <Label fx:id="emptyState" text="No notes recorded." styleClass="text-muted"/>
    <Button text="+  Add note" styleClass="button-add" onAction="#handleAddNote"/>
</VBox>
