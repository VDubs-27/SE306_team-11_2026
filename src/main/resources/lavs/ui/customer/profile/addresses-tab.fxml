<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.customer.profile.AddressesTabController"
      spacing="12">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing -->
        <fx:include fx:id="addressForm" source="/lavs/ui/customer/forms/address-form.fxml"/>
    </fx:define>
    <VBox fx:id="addressList" spacing="12"/>
    <fx:include fx:id="pager" source="/lavs/ui/common/pager.fxml"/>
    <Button text="+  Add address" styleClass="button-add" onAction="#handleAddAddress"/>
    <HBox styleClass="note">
        <Label text="ⓘ" minWidth="-Infinity"/>
        <Label text="Loan documents go to the mailing address. A customer needs a mailing address and at least one phone or email before a new loan can start."/>
    </HBox>
</VBox>
