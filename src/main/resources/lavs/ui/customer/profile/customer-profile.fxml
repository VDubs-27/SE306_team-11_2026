<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.customer.profile.CustomerProfileController"
            styleClass="page-scroll" fitToWidth="true">
    <VBox styleClass="page" alignment="TOP_CENTER">
        <VBox spacing="16" maxWidth="960">

            <Hyperlink text="‹  Back to search results" onAction="#handleBack"/>

            <!-- Summary card: who the customer is, then key facts separated by thin lines. The facts and button
                 keep their full width; a long name wraps instead. -->
            <HBox styleClass="card, summary-card" alignment="CENTER_LEFT">
                <Label fx:id="initialsAvatar" styleClass="avatar, avatar-large"/>
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="nameLabel" styleClass="summary-name" wrapText="true" minWidth="140"/>
                    <Label fx:id="statusBadge" styleClass="badge"/>
                </VBox>
                <HBox styleClass="summary-fact">
                    <Region styleClass="summary-divider"/>
                    <VBox styleClass="summary-fact-text">
                        <Label text="CUSTOMER NUMBER" styleClass="summary-caption"/>
                        <Label fx:id="customerNumberLabel" minWidth="-Infinity" styleClass="summary-value, summary-number, mono"/>
                    </VBox>
                </HBox>
                <HBox fx:id="dateOfBirthFact" styleClass="summary-fact">
                    <Region styleClass="summary-divider"/>
                    <VBox styleClass="summary-fact-text">
                        <Label text="DATE OF BIRTH" styleClass="summary-caption"/>
                        <Label fx:id="dateOfBirthLabel" minWidth="-Infinity" styleClass="summary-value"/>
                    </VBox>
                </HBox>
                <HBox fx:id="suburbFact" styleClass="summary-fact">
                    <Region styleClass="summary-divider"/>
                    <VBox styleClass="summary-fact-text">
                        <Label text="SUBURB" styleClass="summary-caption"/>
                        <Label fx:id="suburbLabel" minWidth="-Infinity" styleClass="summary-value"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+  New loan" minWidth="-Infinity" styleClass="button-primary, button-large" onAction="#handleNewLoan"/>
            </HBox>

            <!-- Tabs card -->
            <VBox styleClass="card, card-flush">
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                    <Tab text="Details">
                        <fx:include fx:id="details" source="details-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="addressesTab" text="Addresses">
                        <fx:include fx:id="addresses" source="addresses-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="contactsTab" text="Contacts">
                        <fx:include fx:id="contacts" source="contacts-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="employmentTab" text="Employment">
                        <fx:include fx:id="employment" source="employment-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="loansTab" text="Loans">
                        <fx:include fx:id="loans" source="loans-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="documentsTab" text="Documents">
                        <fx:include fx:id="documents" source="/lavs/ui/common/documents-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="notesTab" text="Notes">
                        <fx:include fx:id="notes" source="/lavs/ui/common/notes-tab.fxml"/>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
