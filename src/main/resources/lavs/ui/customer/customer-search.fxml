<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.customer.CustomerSearchController"
            fx:id="pageScroll" styleClass="page-scroll" fitToWidth="true">
    <!-- At least as tall as the window, so the results card can fill the rest of it -->
    <VBox fx:id="page" styleClass="page" alignment="TOP_CENTER">

        <!-- Search card -->
        <VBox styleClass="card" maxWidth="960">
            <Label text="Find a customer"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                           promptText="Search by name or customer number"/>
                <Button fx:id="searchButton" text="Search" styleClass="button-secondary"
                        defaultButton="true" onAction="#handleSearch"/>
                <Button text="+ Add customer" styleClass="button-primary"
                        onAction="#handleAddCustomer"/>
            </HBox>
        </VBox>

        <!-- Results card: no padding, so the table spans the full width; fills the rest of the window -->
        <VBox fx:id="resultsCard" styleClass="card, card-flush" maxWidth="960" VBox.vgrow="ALWAYS">

            <!-- Title row -->
            <HBox styleClass="card-section" alignment="CENTER_LEFT">
                <Label fx:id="resultsTitle" text="Customers" styleClass="heading-2"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="resultCount" styleClass="text-muted"/>
            </HBox>

            <!-- The table, just tall enough for this page of results, or the message in its place.
                 Any room left over stays as white card below. -->
            <VBox VBox.vgrow="ALWAYS">
                <StackPane fx:id="tableBox">
                    <VBox.margin>
                        <Insets left="-1" right="-1"/>
                    </VBox.margin>
                    <TableView fx:id="resultsTable" styleClass="search-table">
                        <columns>
                            <TableColumn fx:id="nameColumn" text="Name"/>
                            <TableColumn fx:id="customerNumberColumn" text="Customer number"/>
                            <TableColumn fx:id="dateOfBirthColumn" text="Date of birth"/>
                            <TableColumn fx:id="arrowColumn" sortable="false" resizable="false"
                                         reorderable="false" minWidth="48" maxWidth="48" prefWidth="48"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                        </columnResizePolicy>
                    </TableView>
                </StackPane>
                <!-- Shown instead of the table before searching, or when nothing matches -->
                <Label fx:id="emptyState" styleClass="empty-state, search-empty-state" wrapText="true"
                       maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- Prev / page / Next, only when the results run over more than one page -->
            <VBox fx:id="pagerSection" styleClass="card-section">
                <fx:include fx:id="pager" source="/lavs/ui/common/pager.fxml"/>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
