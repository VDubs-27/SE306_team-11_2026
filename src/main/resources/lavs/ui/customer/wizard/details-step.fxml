<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.customer.wizard.DetailsStepController"
      styleClass="card, card-flush">

    <HBox styleClass="card-section, card-divider" alignment="CENTER_LEFT">
        <Label text="Customer details" styleClass="section-heading"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="All fields are required unless marked optional" styleClass="text-muted, text-small"/>
    </HBox>

    <VBox styleClass="card-section" spacing="16">
        <fx:include fx:id="form" source="/lavs/ui/customer/forms/customer-details-form.fxml"/>

        <HBox styleClass="note">
            <Label text="ⓘ" minWidth="-Infinity"/>
            <Label text="Check each detail with the customer before moving on."/>
        </HBox>
    </VBox>
</VBox>
