<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="lavs.ui.loan.view.LoanViewController"
            styleClass="page-scroll" fitToWidth="true">
    <VBox styleClass="page" alignment="TOP_CENTER">
        <VBox spacing="16" maxWidth="960">

            <Hyperlink fx:id="backLink" onAction="#handleBack"/>

            <!-- Summary card, styled like the profile's: which loan and its status, then key facts -->
            <HBox styleClass="card, summary-card" alignment="CENTER_LEFT">
                <Label text="\$" styleClass="loan-icon"/>
                <VBox spacing="6" alignment="CENTER_LEFT">
                    <Label fx:id="loanNumberLabel" minWidth="-Infinity" styleClass="summary-name, summary-loan-number, mono"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="statusBadge"/>
                        <Label fx:id="customerValue" minWidth="-Infinity" styleClass="text-muted"/>
                    </HBox>
                </VBox>
                <HBox styleClass="summary-fact">
                    <Region styleClass="summary-divider"/>
                    <VBox styleClass="summary-fact-text">
                        <Label text="PRINCIPAL" styleClass="summary-caption"/>
                        <Label fx:id="principalValue" minWidth="-Infinity" styleClass="summary-value"/>
                    </VBox>
                </HBox>
                <HBox styleClass="summary-fact">
                    <Region styleClass="summary-divider"/>
                    <VBox styleClass="summary-fact-text">
                        <Label text="INTEREST" styleClass="summary-caption"/>
                        <Label fx:id="interestValue" minWidth="-Infinity" styleClass="summary-value"/>
                    </VBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="submitButton" minWidth="-Infinity" text="Submit for approval" styleClass="button-primary, button-large"
                        onAction="#handleSubmitForApproval"/>
            </HBox>

            <!-- Totals over the life of the loan -->
            <HBox spacing="16">
                <VBox styleClass="card, stat-tile" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="Total to repay" styleClass="tile-caption"/>
                    <Label fx:id="totalPaidValue" styleClass="stat-value"/>
                    <Label fx:id="paymentCountValue" styleClass="text-muted, text-small"/>
                </VBox>
                <VBox styleClass="card, stat-tile" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="Total interest" styleClass="tile-caption"/>
                    <Label fx:id="totalInterestValue" styleClass="stat-value"/>
                    <Label text="over the life of the loan" styleClass="text-muted, text-small"/>
                </VBox>
                <VBox styleClass="card, stat-tile" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="Repayments" styleClass="tile-caption"/>
                    <Label fx:id="repaymentValue" styleClass="stat-value"/>
                    <Label fx:id="repaymentStartValue" styleClass="text-muted, text-small"/>
                </VBox>
                <VBox styleClass="card, stat-tile" HBox.hgrow="ALWAYS" prefWidth="0">
                    <Label text="Final payment" styleClass="tile-caption"/>
                    <Label fx:id="finalDateValue" styleClass="stat-value"/>
                    <Label fx:id="finalAmountValue" styleClass="text-muted, text-small"/>
                </VBox>
            </HBox>

            <!-- Tabs card -->
            <VBox styleClass="card, card-flush">
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
                    <Tab text="Details">
                        <fx:include fx:id="details" source="details-tab.fxml"/>
                    </Tab>
                    <Tab text="Schedule">
                        <fx:include fx:id="schedule" source="schedule-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="coborrowersTab" text="Co-borrowers">
                        <fx:include fx:id="coborrowers" source="coborrowers-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="documentsTab" text="Documents">
                        <fx:include fx:id="documents" source="/lavs/ui/common/documents-tab.fxml"/>
                    </Tab>
                    <Tab fx:id="notesTab" text="Notes">
                        <fx:include fx:id="notes" source="/lavs/ui/common/notes-tab.fxml"/>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </VBox>
</ScrollPane>
