<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.loan.view.NotesTabController"
      spacing="12">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing a note -->
        <fx:include fx:id="noteForm" source="/lavs/ui/common/note-form.fxml"/>
    </fx:define>

    <Label text="Notes" styleClass="section-heading"/>
    <VBox fx:id="noteList" spacing="12"/>
    <fx:include fx:id="pager" source="/lavs/ui/common/pager.fxml"/>
    <Button fx:id="addButton" text="+  Add note" styleClass="button-add" maxWidth="Infinity"
            onAction="#handleAddNote"/>
    <HBox styleClass="note">
        <Label text="ⓘ" minWidth="-Infinity"/>
        <Label fx:id="lockNote"/>
    </HBox>
</VBox>
