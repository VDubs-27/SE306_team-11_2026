<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.loan.wizard.UploadStepController"
      spacing="16">
    <fx:define>
        <!-- Shown in a pop-up when adding or editing a document -->
        <fx:include fx:id="documentForm" source="/lavs/ui/common/document-form.fxml"/>
    </fx:define>

    <!-- Supporting documents -->
    <VBox styleClass="card, card-flush">
        <HBox styleClass="card-section, card-divider" alignment="CENTER_LEFT">
            <Label text="Supporting documents" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Optional" styleClass="chip-unmet"/>
        </HBox>
        <VBox styleClass="card-section" spacing="12">
            <VBox fx:id="documentList" spacing="12"/>
            <Button text="+  Add document" styleClass="button-add" onAction="#handleAddDocument"/>
            <HBox styleClass="note">
                <Label text="ⓘ" minWidth="-Infinity"/>
                <Label text="Only each file's name, type and size are recorded. Documents are added to the loan once it is submitted."/>
            </HBox>
        </VBox>
    </VBox>

    <!-- The loan details, to check before adding people -->
    <VBox styleClass="card, card-flush">
        <HBox styleClass="card-section, card-divider" alignment="CENTER_LEFT">
            <Label text="Review loan details" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Change" styleClass="link-strong" onAction="#handleChangeDetails"/>
        </HBox>
        <VBox fx:id="summary" styleClass="card-section"/>
    </VBox>
</VBox>
