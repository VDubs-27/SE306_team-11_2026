<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written with Claude from the team's mockups; reviewed by Jack Preston. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.loan.wizard.UploadStepController"
      spacing="16">
    <!-- The loan details, to check before adding people -->
    <VBox styleClass="card, card-flush">
        <HBox styleClass="card-section, card-divider" alignment="CENTER_LEFT">
            <Label text="Review loan details" styleClass="section-heading"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink text="Change" styleClass="link-strong" onAction="#handleChangeDetails"/>
        </HBox>
        <VBox fx:id="summary" styleClass="card-section"/>
    </VBox>
</VBox>
