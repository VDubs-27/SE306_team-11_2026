<?xml version="1.0" encoding="UTF-8"?>
<!-- AI-assisted: written by Jack, refined with Claude. -->
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lavs.ui.loan.wizard.CoborrowersStepController"
      styleClass="card, card-flush">

    <HBox styleClass="card-section, card-divider" alignment="CENTER_LEFT">
        <Label text="Co-borrowers and guarantors" styleClass="section-heading"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="loanSummary" styleClass="text-muted, text-small"/>
    </HBox>

    <VBox styleClass="card-section" spacing="12">
        <fx:include fx:id="people" source="/lavs/ui/loan/people/loan-people.fxml"/>
        <HBox styleClass="note">
            <Label text="ⓘ" minWidth="-Infinity"/>
            <Label text="Add each person as a co-borrower or a guarantor. Both are optional, but an applicant with no employment needs a guarantor. A new customer goes through the new customer wizard first, then returns here."/>
        </HBox>
    </VBox>
</VBox>
